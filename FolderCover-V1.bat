@echo off
setlocal EnableExtensions
title Folder Cover - Drag and Drop

echo.
echo ==============================================
echo       FOLDER COVER - DRAG AND DROP
echo ==============================================
echo.

if "%~1"=="" (
    echo Tidak ada folder yang dipilih.
    echo.
    echo Drag sebuah folder ke file BAT ini.
    echo.
    pause
    exit /b 1
)

set "FOLDER_COVER_TARGET=%~1"

if not exist "%FOLDER_COVER_TARGET%\." (
    echo Item yang dipilih bukan folder:
    echo %FOLDER_COVER_TARGET%
    echo.
    pause
    exit /b 1
)

echo Folder target:
echo %FOLDER_COVER_TARGET%
echo.
echo Menjalankan proses...
echo.

powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand 
set "PSERROR=%ERRORLEVEL%"

echo.
if not "%PSERROR%"=="0" (
    echo ==============================================
    echo PROSES BERHENTI KARENA ERROR
    echo ==============================================
    echo Kode error: %PSERROR%
    echo.
    echo echo Screenshot jendela ini dan simpan untuk troubleshooting.
) else (
    echo ==============================================
    echo PROSES SELESAI
    echo ==============================================
)
echo.
pause
endlocal
